{
  "name": "@dwellentix/auth",
  "version": "1.2.0",
  "description": "Universal authentication and ODE capability mapping for Dwellentix API and UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
