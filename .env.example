# Registry API Port
PORT=4873
HOST=localhost

# Database (Default: SQLite for zero-config local runs)
DATABASE_URL="file:./dev.db"

# Storage Configuration
# Options: "local", "gcs" (Google Cloud Storage), or "s3"
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage/tarballs

# Google Cloud Storage (GCS) Configuration (when STORAGE_TYPE=gcs)
GCS_BUCKET_NAME=my-jmpm-tarballs-bucket
GCS_PROJECT_ID=my-gcp-project-id
# Path to service account key file (optional if running on GCP with Workload Identity or ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# JWT Secret for Auth Tokens
JWT_SECRET=super-secret-jmpm-registry-token-key-change-in-prod

# Security: Enforce authentication even for reading/downloading packages (Private Registry mode)
REQUIRE_AUTH_FOR_READ=true

# Upstream Fallback Registry (optional)
UPSTREAM_REGISTRY=https://registry.npmjs.org

